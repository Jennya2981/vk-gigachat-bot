# =====================================================================
#  Шаблон переменных окружения.
#  Скопируйте этот файл в .env и заполните СВОИМИ значениями.
#  Реальные ключи и токены в этот файл (и в Git) не попадают.
# =====================================================================

# ---------- GigaChat API (Сбер) ----------
# Ключ авторизации (Authorization Key) из личного кабинета GigaChat API.
# Пример формата: <client_id>:<client_secret> в base64, выдаётся один раз.
GIGACHAT_CREDENTIALS=

# Версия API: GIGACHAT_API_PERS (физлица),
# GIGACHAT_API_B2B или GIGACHAT_API_CORP (юрлица / ИП).
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель: GigaChat-2, GigaChat-2-Pro, GigaChat-2-Max, GigaChat-3-Ultra.
GIGACHAT_MODEL=GigaChat-2

# Базовый адрес GigaChat API.
GIGACHAT_BASE_URL=https://api.giga.chat/v1

# Путь к корневому сертификату НУЦ Минцифры (рекомендуемый безопасный вариант).
# Если указан — проверка TLS идёт по этому сертификату.
GIGACHAT_CA_BUNDLE_FILE=

# Проверять TLS-сертификат (true/false). Ставьте false только для отладки,
# когда сертификат Минцифры не установлен. Для продакшена лучше true + CA-файл.
GIGACHAT_VERIFY_SSL=true

# ---------- ВКонтакте ----------
# Ключ доступа сообщества (Управление -> Работа с API -> Ключи доступа).
VK_TOKEN=

# ID сообщества ВКонтакте. Можно числовой ID (без минуса) либо короткое имя.
VK_GROUP_ID=
